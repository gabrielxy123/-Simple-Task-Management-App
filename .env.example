# ============================================================
#  .env.example — Template konfigurasi
#  Salin file ini menjadi .env dan isi dengan nilai asli.
#  JANGAN commit file .env ke Git!
# ============================================================

# ── Database ─────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ganti_dengan_password_kuat
POSTGRES_DB=taskdb

# ── JWT Auth ─────────────────────────────────────────────────
# Generate secret key dengan: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=ganti_dengan_secret_key_panjang_dan_acak
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── AI / Chatbot ─────────────────────────────────────────────
# Groq API Key → https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# HuggingFace Token (optional) → https://huggingface.co/settings/tokens
HF_API_TOKEN=

# Google Gemini (deprecated/optional)
GEMINI_API_KEY=
